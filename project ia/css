
@import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');

:root {
    --cor-fundo: #101526;
    --cor-caixa: #1b243b;
    --cor-texto: #f2f5ff;
    --cor-destaque: #77e5d1;
    --cor-botao: #394867;
    --cor-botao-hover: #4d628c;
    --cor-borda: #39445e;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 24px;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--cor-fundo);
    color: var(--cor-texto);
    font-family: 'Inter', sans-serif;
}

.caixa-principal {
    width: 100%;
    max-width: 760px;
    padding: 32px;
    background: var(--cor-caixa);
    border: 1px solid var(--cor-borda);
    border-radius: 20px;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.25);
}

h1,
h2,
.caixa-perguntas {
    font-family: 'Chakra Petch', sans-serif;
}

h1 {
    margin-top: 0;
    color: var(--cor-destaque);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
}

h2 {
    color: var(--cor-destaque);
}

p {
    line-height: 1.8;
}

.tela-entrada {
    text-align: center;
    padding: 35px 10px;
}

.tela-entrada h1 {
    margin-bottom: 32px;
}

.tela-inicial {
    display: none;
}

.tela-inicial p {
    margin-bottom: 28px;
}

.caixa-perguntas,
.caixa-alternativas,
.caixa-resultado {
    display: none;
}

.caixa-perguntas.mostrar,
.caixa-alternativas.mostrar,
.caixa-resultado.mostrar {
    display: block;
}

.caixa-perguntas {
    margin: 18px 0;
    font-size: 1.3rem;
    line-height: 1.6;
}

.caixa-alternativas {
    flex-direction: column;
    gap: 10px;
}

.caixa-alternativas.mostrar {
    display: flex;
}

button {
    width: 100%;
    padding: 14px 18px;
    border: 1px solid var(--cor-borda);
    border-radius: 10px;
    background: var(--cor-botao);
    color: var(--cor-texto);
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
}

button:hover {
    background: var(--cor-botao-hover);
    transform: translateY(-1px);
}

button:focus-visible {
    outline: 3px solid var(--cor-destaque);
    outline-offset: 3px;
}

.entrar-btn,
.iniciar-btn,
.novamente-btn {
    background: var(--cor-destaque);
    color: #101526;
    border: none;
}

.entrar-btn:hover,
.iniciar-btn:hover,
.novamente-btn:hover {
    background: #9af3e4;
}

.caixa-resultado {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--cor-borda);
}

.texto-resultado {
    white-space: normal;
    overflow-wrap: anywhere;
}

@media (max-width: 520px) {
    body {
        padding: 12px;
    }

    .caixa-principal {
        padding: 22px;
    }

    .caixa-perguntas {
        font-size: 1.15rem;
    }
}